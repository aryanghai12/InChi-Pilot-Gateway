# ==============================================================================
# InChi Pilot Gateway - Database & Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Update placeholder values for your local development environment.
# 3. NEVER commit the actual '.env' file containing real secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=insecure-dev-key-change-in-production-inchi-gateway-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Centralized PostgreSQL Database Configuration (Docker & Django)
# ------------------------------------------------------------------------------
# Database credentials used by both Docker Compose and Django
DB_NAME=inchi_db
DB_USER=inchi_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Connection reuse & health checks (seconds)
# CONN_MAX_AGE: keeps connections open across requests in a worker thread.
# DB_CONN_HEALTH_CHECKS: validates connection liveness before reuse.
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Optional: Client-side Connection Pooling (Django 5.1+ with psycopg_pool)
# Set DB_POOL_ENABLED=True to activate psycopg_pool connection pool.
DB_POOL_ENABLED=False
DB_POOL_MIN_CONNS=1
DB_POOL_MAX_CONNS=10
DB_POOL_TIMEOUT=30.0

# Optional: Offline SQLite fallback (set to True for quick offline tests without Docker)
USE_SQLITE=False

# Optional: Database URL override (if provided, parsed automatically)
# DATABASE_URL=postgresql://inchi_user:change_me@localhost:5432/inchi_db

