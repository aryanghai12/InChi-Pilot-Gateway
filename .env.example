# ==============================================================================
# InChi Pilot Gateway v0.1 — Canonical Environment Template (.env.example)
# Workstream Owner: Ajendra Nath Tripathi (Cybersecurity and DevSecOps Engineer)
# Authority: AGENTS.md §B rule 7, §C2; ARCHITECTURE.md §5, §7, §8; MVP_FEATURES.md §8
#
# SECURITY DIRECTIVES:
# 1. NEVER commit real credentials, passwords, or production secrets to source control.
# 2. In non-production local development, copy this file to .env.
# 3. All passwords and keys below are UNAPPROVED placeholders for local development only.
# 4. Gitleaks continuously monitors git commits and will block commits containing real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 17 + pgvector)
# Managed by: Vishal Chauhan (Data and Platform Services Engineer)
# ------------------------------------------------------------------------------
POSTGRES_DB=inchi_pilot
POSTGRES_USER=inchi_user
POSTGRES_PASSWORD=unapproved_dev_postgres_password_placeholder_only
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://inchi_user:unapproved_dev_postgres_password_placeholder_only@db:5432/inchi_pilot

# ------------------------------------------------------------------------------
# 2. DJANGO BACKEND CONFIGURATION (Python 3.12, Django 5.2 LTS, DRF)
# Managed by: Abhishek Kumar (Application Backend and Access-Control Engineer)
# ------------------------------------------------------------------------------
# Cryptographic secret key for session signing and CSRF tokens
DJANGO_SECRET_KEY=unapproved_django_secret_key_dummy_token_for_local_development_only

# Set to False in staging and any shared environments (ARCHITECTURE.md §5)
DJANGO_DEBUG=True

# Hostname validation (TD-09, ARCHITECTURE.md §5)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend,backend

# Public origins allowed to submit CSRF-protected requests (TD-05, TD-09)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Security Flags (Set to True behind HTTPS / Staging per AUTH_THREAT_REVIEW.md)
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_HTTPONLY=True
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_AGE=28800

# Custom URL prefixes for security obfuscation (TD-08)
ADMIN_URL_PATH=admin
DJANGO_STATIC_PREFIX=static

# Internal inter-service endpoint for FastAPI AI Matching Engine
FASTAPI_MATCHING_URL=http://backend:8001

# ------------------------------------------------------------------------------
# 3. FASTAPI AI MATCHING ENGINE CONFIGURATION (Component B)
# Managed by: Alok Tiwari (AI Matching and Data Intelligence Engineer)
# ------------------------------------------------------------------------------
MATCHING_ENGINE_HOST=0.0.0.0
MATCHING_ENGINE_PORT=8001

# Local Embedding Provider (D-11: Sentence-Transformers or FastEmbed; Model TBD)
# Strict security requirement: No external LLM/AI APIs permitted (D-20, T-ID-03)
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL_NAME=TBD-D11-PENDING-APPROVAL

# Strict local telemetry suppression (prevents data egress to public Hugging Face Hub)
HF_HUB_DISABLE_TELEMETRY=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Next.js App Router, React 19, TypeScript)
# Managed by: Priyanka Singh (Frontend Web and Client-Side Integration Engineer)
# ------------------------------------------------------------------------------
# Internal server-side reverse proxy destination (TD-09, TD-10)
# Browser connects ONLY to Next.js; Next.js proxies /api/ requests to BACKEND_ORIGIN
BACKEND_ORIGIN=http://backend:8000
PORT=3000
NODE_ENV=development

# Disable Next.js anonymous usage telemetry for privacy & compliance
NEXT_TELEMETRY_DISABLED=1

