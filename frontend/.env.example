# InChi Pilot Gateway - Frontend Environment Configuration Template
# Copy this file to .env.local for local development overrides:
#   cp .env.example .env.local

# Target Django backend origin (proxy destination for /api/* and /admin/*)
BACKEND_ORIGIN=http://localhost:8000

# Restricted Django Admin URL path prefix (decision D-12)
ADMIN_URL_PATH=admin

# Django static asset URL path prefix
DJANGO_STATIC_PREFIX=static

# Next.js Node environment (development | production | test)
NODE_ENV=development

# Next.js development server port
PORT=3000
